// Cloudflare Workers configuration. The site is fully static: `node build.mjs`
// writes dist/, and the Worker only serves that folder as assets.
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "name": "en-datatool",
  "compatibility_date": "2026-09-01",
  // Tiny Worker in front of the assets: 301 redirects (see worker/index.js).
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
  },
}
